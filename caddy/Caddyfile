*.{$MY_DOMAIN} {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1 1.0.0.1
    }

    @actual host actual.{$MY_DOMAIN}
    handle @actual {
        reverse_proxy actual_server:5006
    }

    @dozzle host dozzle.{$MY_DOMAIN}
    handle @dozzle {
        reverse_proxy dozzle:8080
    }

    @pdf host pdf.{$MY_DOMAIN}
    handle @pdf {
        handle /agent-files/* {
            reverse_proxy stirling-pdf-mcp:8000
        }
        handle {
            reverse_proxy stirling-pdf:8080
        }
    }

    @backrest host backrest.{$MY_DOMAIN}
    handle @backrest {
        reverse_proxy backrest:9898
    }

    @homepage host homepage.{$MY_DOMAIN}
    handle @homepage {
        reverse_proxy homepage:3000
    }

    @librechat host librechat.{$MY_DOMAIN}
    handle @librechat {
        reverse_proxy librechat:3080
    }

    @cliproxy host cliproxy.{$MY_DOMAIN}
    handle @cliproxy {
        @root path /
        redir @root /management.html 302
        reverse_proxy cliproxyapi:8317
    }

    @executor host executor.{$MY_DOMAIN}
    handle @executor {
        reverse_proxy executor:4788
    }

    @per host per.{$MY_DOMAIN}
    handle @per {
        reverse_proxy personal-management:8000
    }

    handle {
        respond "Unknown homelab service" 404
    }
}
