*.{$MY_DOMAIN} {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1 1.0.0.1
    }

    @pdf host pdf.{$MY_DOMAIN}
    handle @pdf {
        reverse_proxy stirling-pdf:8080
    }

    @backrest host backrest.{$MY_DOMAIN}
    handle @backrest {
        reverse_proxy backrest:9898
    }

    @librechat host librechat.{$MY_DOMAIN}
    handle @librechat {
        reverse_proxy librechat:3080
    }


    handle {
        respond "Unknown homelab service" 404
    }
}
